<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_stock_picking_tag_list" model="ir.ui.view">
        <field name="name">stock.picking.tag.list</field>
        <field name="model">stock.picking.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>


    <record id="view_stock_picking_tag_form" model="ir.ui.view">
        <field name="name">stock.picking.tag.form</field>
        <field name="model">stock.picking.tag</field>
        <field name="arch" type="xml">
            <form string="Transfer Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_stock_picking_tag" model="ir.actions.act_window">
        <field name="name">Transfer Tags</field>
        <field name="res_model">stock.picking.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Add Tags to Picking Form View (Receipts, Delivery Orders, etc.) -->
    <record id="view_picking_form_inherit_tags" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.tags</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="tag_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>


    <record id="view_picking_list_inherit_tags" model="ir.ui.view">
        <field name="name">stock.picking.list.inherit.tags</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='scheduled_date']" position="after">
                <field name="tag_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

     <record id="view_picking_search_inherit_tags" model="ir.ui.view">
        <field name="name">stock.picking.search.inherit.tags</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='late']" position="after">
                <filter name="filter_by_tags"
                        string="Tags"
                        domain="[]"
                        context="{}"
                        help="Filter by assigned tags"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <field name="tag_ids" string="Tags" filter_domain="[]"
                       widget="many2many_tags" />
            </xpath>
        </field>
    </record>




    <menuitem id="menu_stock_picking_tag_root"
              name="Transfer Tags"
              parent="stock.menu_stock_warehouse_mgmt"
              sequence="30"/>

    <menuitem id="menu_stock_picking_tag"
              name="Tags"
              parent="menu_stock_picking_tag_root"
              action="action_stock_picking_tag"
              sequence="10"/>
</odoo>
